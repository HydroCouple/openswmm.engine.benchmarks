[CONTROLS]
RULE DROPSHAFT1-1
IF NODE DummyDropShaft1 DEPTH >= 30
THEN ORIFICE Sluicegate1@CSO428JunChamber SETTING = 0
PRIORITY 1
RULE DROPSHAFT1-2
IF NODE DummyDropShaft1 DEPTH > 0
AND NODE DummyDropShaft1 DEPTH < 30
THEN ORIFICE Sluicegate1@CSO428JunChamber SETTING = CURVE TUNNEL
PRIORITY 2
RULE DROPSHAFT1-3
IF NODE DummyDropShaft1 DEPTH <= 0
THEN ORIFICE Sluicegate1@CSO428JunChamber SETTING = 1
PRIORITY 3
RULE DROPSHAFT2-1
IF NODE DummyDropShaft2 DEPTH >= 30
THEN ORIFICE DropShaft2JunChamberSluiceGate1 SETTING = 0
PRIORITY 1
RULE DROPSHAFT2-2
IF NODE DummyDropShaft2 DEPTH > 0
AND NODE DummyDropShaft2 DEPTH < 30
THEN ORIFICE DropShaft2JunChamberSluiceGate1 SETTING = CURVE TUNNEL
PRIORITY 2
RULE DROPSHAFT2-3
IF NODE DummyDropShaft2 DEPTH <= 0
THEN ORIFICE DropShaft2JunChamberSluiceGate1 SETTING = 1
PRIORITY 3
RULE DROPSHAFT3-1
IF NODE DummyDropShaft3 DEPTH >= 30
THEN ORIFICE CSO3-5ConsolidationSewerSluiceGate SETTING = 0
PRIORITY 1
RULE DROPSHAFT3-2
IF NODE DummyDropShaft3 DEPTH > 0
AND NODE DummyDropShaft3 DEPTH < 30
THEN ORIFICE CSO3-5ConsolidationSewerSluiceGate SETTING = CURVE TUNNEL
PRIORITY 2
RULE DROPSHAFT3-3
IF NODE DummyDropShaft3 DEPTH <= 0
THEN ORIFICE CSO3-5ConsolidationSewerSluiceGate SETTING = 1
PRIORITY 3
RULE DROPSHAFT3-4
IF NODE 29407038 Depth > 0
THEN WEIR CSO5DivChamberSluiceGate1 SETTING = CURVE CS05WEIR
RULE DROPSHAFT3-6
IF NODE DummyDropShaft3 DEPTH >= 30
THEN ORIFICE Orifice@CSO5Gate SETTING = 0
PRIORITY 1
RULE DROPSHAFT3A-1
IF NODE DummyDropShaft3A DEPTH >= 30
THEN ORIFICE DropShaft3AJunChamberSluiceGate1 SETTING = 0
PRIORITY 1
RULE DROPSHAFT3A-2
IF NODE DummyDropShaft3A DEPTH > 0
AND NODE DummyDropShaft3A DEPTH < 30
THEN ORIFICE DropShaft3AJunChamberSluiceGate1 SETTING = CURVE TUNNEL
PRIORITY 2
RULE DROPSHAFT3A-3
IF NODE DummyDropShaft3A DEPTH <= 0
THEN ORIFICE DropShaft3AJunChamberSluiceGate1 SETTING = 1
PRIORITY 3
RULE EHRT_OnOff
IF Node ScreenShaft Depth >= 40
AND LINK WWTP_DIS-WWTP_OUT FLOW > 0
THEN PUMP Pump@HRT SETTING = CURVE EHRT
ELSE PUMP Pump@HRT SETTING = 0
RULE JockeyPump_OFF
IF Node ScreenShaft Depth <= 3.25
THEN PUMP Pump@WWTP-Jockey status = OFF
RULE JockeyPump_Off2
IF PUMP Pump@WWTP_HRT FLOW > 0
OR PUMP Pump@HRT FLOW > 0
THEN PUMP Pump@WWTP-Jockey status = OFF
PRIORITY 1
RULE JockeyPump_ON
IF Node ScreenShaft Depth > 34
THEN PUMP Pump@WWTP-Jockey status = ON
RULE JockeyPump_ONOFF
IF Node ScreenShaft Depth > 3.25
AND PUMP Pump@WWTP-Jockey status = ON
THEN PUMP Pump@WWTP-Jockey status = ON
ELSE PUMP Pump@WWTP-Jockey status = OFF
