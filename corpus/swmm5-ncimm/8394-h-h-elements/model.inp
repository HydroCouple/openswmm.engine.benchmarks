;;;;-- CSO 005 RTC Operations -- Lick Run
; Lick Run Middle Orifice gates
Rule LickRun001
IF NODE 29407038 DEPTH <= 9.28
THEN Orifice cso005middle setting = 0
Rule LickRun002
IF Node 29407038 Depth > 18.78
THEN Orifice cso005middle setting = 1
Rule LickRun003
IF Node 29407038 Depth > 9.28
and Orifice cso005middle setting = 1
THEN Orifice cso005middle setting = 1
ELSE Orifice cso005middle setting = 0
; Lick Run Lower Orifice gates
Rule LickRun004
IF Node 29407038 Depth <= 3.28
THEN Orifice cso005lower setting = 0
Rule LickRun005
IF Node 29407038 Depth > 20.28
THEN Orifice cso005lower setting = 1
Rule LickRun006
IF Node 29407038 Depth > 3.28
and Orifice cso005lower setting = 1
THEN Orifice cso005lower setting = 1
ELSE Orifice cso005lower setting = 0
