OR SIMULATION TIME = 6446
OR SIMULATION TIME = 6668
OR SIMULATION TIME = 6776
OR SIMULATION TIME = 7219
OR SIMULATION TIME = 7847
OR SIMULATION TIME = 8233
OR SIMULATION TIME = 8626
OR SIMULATION TIME = 8740
OR SIMULATION TIME = 3840
OR SIMULATION TIME = 4800
OR SIMULATION TIME = 7296
OR SIMULATION TIME = 8400
OR SIMULATION TIME = 7944
OR SIMULATION TIME = 5616
OR SIMULATION TIME = 6264
THEN WEIR WETLANDEFF SETTING = 1.000000
PRIORITY 4.000000

RULE Z_WETLANDDRAIN2
IF NODE WETLANDEFF DEPTH < 0.100000
THEN WEIR WETLANDEFF SETTING = 0.000000


RULE Z_WETLANDDRAIN3
IF NODE WETLANDEFF DEPTH >= 9.000000
THEN WEIR WETLANDEFF SETTING = 1.000000
PRIORITY 5.000000

