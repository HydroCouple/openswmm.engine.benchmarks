[CONTROLS]
RULE PUMP_40MGD_US
IF PUMP 28MGD_US FLOW < 28.000000
THEN PUMP 40MGD_US STATUS = OFF
ELSE PUMP 40MGD_US STATUS = ON
PRIORITY 0.000000

RULE VTUDRAIN
IF PUMP 28MGD_US FLOW < 28.000000
AND NODE VTU DEPTH > 0.100000
AND LINK VTU_IN FLOW < 0.100000
THEN PUMP VTUDRAIN STATUS = ON
ELSE PUMP VTUDRAIN STATUS = OFF


RULE WEIR_637.1
IF NODE CSO_#4 DEPTH >= 0.000000
THEN WEIR 637.1 SETTING = CURVE CSO4_PUMP


RULE WEIR_CSO3G
IF NODE CSO_#103 DEPTH >= 0.000000
THEN WEIR CSO3G SETTING = CURVE CSO103_GRAVITY


RULE WEIR_CSO4ORG.1
IF NODE CSO_#4 DEPTH >= 0.000000
THEN WEIR CSO4ORG.1 SETTING = CURVE CSO4_GRAVITY
PRIORITY 0.000000

RULE WEIR_EASTPLANTEFFPS
IF NODE CSO_#103 DEPTH >= 0.000000
THEN WEIR EASTPLANTEFFPS SETTING = CURVE CSO103_PUMP
PRIORITY 0.000000

RULE WEIR_WETLANDPSDIVERT
IF NODE EASTWWTP DEPTH > 10.830000
OR PUMP 90011 FLOW >= 40.000000
OR LINK 410.1 FLOW >= 40.000000
OR PUMP 40MGDPRIMARYBYPASS_P FLOW > 0.000000
THEN WEIR WETLANDPSDIVERT SETTING = 0.000000
ELSE WEIR WETLANDPSDIVERT SETTING = 1.000000


RULE WEIR_WETLANDTOPLANTEFFLUENTPS
IF NODE CSO_#103 DEPTH >= 3.830000
AND LINK PLANTEFFLUENT FLOW < 68.000000
AND NODE 415 DEPTH < 16.000000
THEN WEIR WETLANDTOPLANTEFFLUENTPS SETTING = 1.000000
AND WEIR WETLANDEFF1 SETTING = 0.000000
ELSE WEIR WETLANDTOPLANTEFFLUENTPS SETTING = 0.000000
AND WEIR WETLANDEFF1 SETTING = 1.000000


RULE Z_WETLANDDRAIN_NO_PRIMARYBYPASS
IF NODE WETLANDEFF DEPTH >= 1.000000
AND SIMULATION TIME = 384
OR SIMULATION TIME = 1381
OR SIMULATION TIME = 1633
OR SIMULATION TIME = 1699
OR SIMULATION TIME = 2142
OR SIMULATION TIME = 2229
OR SIMULATION TIME = 2685
OR SIMULATION TIME = 3672
OR SIMULATION TIME = 4317
