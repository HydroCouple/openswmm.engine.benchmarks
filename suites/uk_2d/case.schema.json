{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UK EA 2D generated case contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "uk_test", "title", "dx", "end", "step", "n", "bounds", "cell_count", "area_m2", "initial_volume_m3", "probe_count", "reference_class", "observed_status", "deviations", "source_hashes", "model_sha256", "probes_sha256", "numerical_limits"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^uk-ea-2013-t[0-9]+[ab]?$"},
    "uk_test": {"enum": ["1", "2", "3", "4", "5", "6a", "6b", "7", "8a", "8b"]},
    "title": {"type": "string", "minLength": 3},
    "dx": {"type": "number", "exclusiveMinimum": 0},
    "end": {"type": "number", "exclusiveMinimum": 0},
    "step": {"type": "number", "exclusiveMinimum": 0},
    "n": {"type": "number", "minimum": 0},
    "bounds": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "inlet": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "initial_stage": {"type": "number"},
    "volume": {"type": "number", "minimum": 0},
    "nodata_boundary_cells_excluded": {"type": "integer", "minimum": 0},
    "cell_count": {"type": "integer", "minimum": 1},
    "area_m2": {"type": "number", "exclusiveMinimum": 0},
    "initial_volume_m3": {"type": "number", "minimum": 0},
    "probe_count": {"type": "integer", "minimum": 1},
    "reference_class": {"enum": ["self_consistency", "observed"]},
    "observed_status": {"enum": ["missing", "not_applicable", "available"]},
    "deviations": {"type": "array", "items": {"type": "string"}},
    "source_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "model_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "probes_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "numerical_limits": {"type": "object", "required": ["continuity_pct", "min_depth_m"], "additionalProperties": false, "properties": {"continuity_pct": {"type": "number", "exclusiveMinimum": 0}, "min_depth_m": {"type": "number", "maximum": 0}}},
    "forcing": {"type": "array", "minItems": 2, "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}},
    "boundary_kind": {"enum": ["stage", "flow"]},
    "boundary_width_m": {"type": "number", "exclusiveMinimum": 0}
  }
}
